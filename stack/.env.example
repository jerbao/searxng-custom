# Copy to .env and fill in. DO NOT commit the real .env.

# SearXNG image tag. "latest" tracks upstream; pin a date for stability.
#SEARXNG_VERSION=latest

# Long random string. Generate with: openssl rand -hex 32
SEARXNG_SECRET=replace_with_openssl_rand_hex_32

# Optional: bind SearXNG instance metadata. The Firecrawl endpoint just
# needs the http URL inside the docker network, so this is purely for
# cosmetic self-identification.
SEARXNG_INSTANCE_NAME=hermes-search
SEARXNG_BASE_URL=http://searxng-core:8080
